{
  "name": "frontend-boilerplate",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "showcase": "node scripts/showcase.ts generate",
    "showcase:check": "node scripts/showcase.ts check",
    "showcase:watch": "node scripts/showcase.ts watch",
    "showcase:dev": "node scripts/showcase.ts dev"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
