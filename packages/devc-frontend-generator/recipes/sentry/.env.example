# Sentry(README의 "오류 보고(Sentry)"). DSN을 비우면 SDK를 초기화하지 않아 아무것도 보내지 않는다.

# 서버가 오류를 보낼 DSN. 서버를 띄울 때 읽는다. static-export에는 서버가 없어 쓰지 않는다.
SENTRY_DSN=

# 브라우저가 오류를 보낼 DSN. 빌드할 때 코드에 박힌다. 보통 SENTRY_DSN과 같은 값이다.
NEXT_PUBLIC_SENTRY_DSN=

# 소스맵을 올릴 때만 빌드하는 환경에 넣는다. 인증 토큰은 비밀 값이다. 토큰이 없으면 소스맵을 만들지도 올리지도 않는다.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
