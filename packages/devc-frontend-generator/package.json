{
  "name": "devc-frontend-generator",
  "version": "0.2.1",
  "description": "팀 프론트엔드 Starter를 만들고, Starter 안에서 Schematic으로 코드를 생성하는 CLI",
  "keywords": [
    "nextjs",
    "react",
    "starter",
    "generator",
    "cli",
    "openapi",
    "tanstack-query"
  ],
  "homepage": "https://github.com/project-alone/frontend-boilerplate/tree/master/packages/devc-frontend-generator#readme",
  "bugs": {
    "url": "https://github.com/project-alone/frontend-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-alone/frontend-boilerplate.git",
    "directory": "packages/devc-frontend-generator"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "dcgen": "dist/cli.js"
  },
  "files": [
    "dist",
    "base",
    "rendering-modes",
    "recipes",
    "archetypes",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@clack/prompts": "1.8.1",
    "commander": "^15.0.0",
    "diff": "9.0.0",
    "jiti": "2.7.0",
    "orval": "8.43.0",
    "prettier": "3.9.10",
    "ts-morph": "28.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-types": "12.1.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
