{
  "name": "devc-frontend-generator",
  "version": "0.0.0",
  "description": "팀 프론트엔드 Starter를 만들고, Starter 안에서 Schematic으로 코드를 생성하는 CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dcgen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "base",
    "rendering-modes"
  ],
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "commander": "^15.0.0",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-types": "12.1.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
