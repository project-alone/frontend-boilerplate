# 생성된 Showcase 파일이니 직접 고치지 마세요. 원본을 고친 뒤 레포 최상위에서 npm run showcase로 다시 만듭니다.
# 원본(packages/devc-frontend-generator/): base/.env.example, recipes/auth/.env.example, recipes/seo/.env.example

# 배포 환경에 넣는 환경 변수의 목록. Next.js는 이 파일을 읽지 않는다. 값은 배포 환경(또는 .env.production.local)에 넣고,
# 이 파일에는 적지 않는다. 각 변수의 쓰임은 README와 process-env.d.ts에 있다.

# 서버(서버 컴포넌트, Route Handler, BFF 프록시)가 부르는 백엔드 주소. 배포하는 서버에는 꼭 넣는다.
API_BASE_URL=

# 브라우저가 BFF 프록시 대신 직접 부를 백엔드 주소. 비우면 BFF 프록시(/api/proxy)를 거친다. 빌드할 때 코드에 박힌다.
NEXT_PUBLIC_API_BASE_URL=

# 로그인 세션 쿠키(auth Recipe)를 암호화하는 32자 이상의 비밀 값. 예: `openssl rand -base64 32`의 출력. 배포하는 서버에는 꼭
# 넣고, 서버가 여러 대면 모두 같은 값을 넣는다. 값을 바꾸면 로그인한 사용자가 모두 로그아웃된다.
SESSION_SECRET=

# 사이트의 공개 주소(예: https://www.example.com). sitemap, robots.txt, 페이지의 canonical·OG 주소를 이 주소로 만든다(seo Recipe).
# 빌드할 때 코드에 박히므로 배포용 빌드를 만드는 환경에 꼭 넣는다. 없으면 빌드가 실패한다.
NEXT_PUBLIC_SITE_URL=
