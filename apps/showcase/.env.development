# 생성된 Showcase 파일이니 직접 고치지 마세요. 원본을 고친 뒤 레포 최상위에서 npm run showcase로 다시 만듭니다.
# 원본(packages/devc-frontend-generator/): base/.env.development, recipes/auth/.env.development, recipes/seo/.env.development

# `npm run dev`에서만 읽는다. 값을 바꾸려면 이 파일 대신 .env.development.local에 적는다(README의 "API 목킹").

# enabled이면 서버 컴포넌트와 Route Handler가 보내는 API 요청을 MSW가 받는다. 실제 백엔드를 쓰려면
# .env.development.local에 API_MOCKING=disabled와 API_BASE_URL=<백엔드 주소>를 적는다.
# API_MOCKING만 끄고 API_BASE_URL을 넣지 않으면 개발 서버가 오류를 내고 요청을 처리하지 않는다.
API_MOCKING=enabled

# auth Recipe: 로그인 세션 쿠키를 암호화하는 비밀 값(32자 이상). 개발 서버에서만 쓰는 값이므로 배포 환경에는 이 값을 쓰지 않고
# 따로 만든 값을 넣는다(README의 "인증").
SESSION_SECRET=development-only-session-secret-do-not-deploy

# seo Recipe: sitemap, robots.txt, 페이지의 canonical·OG 주소를 만드는 사이트 주소. 개발 서버(`npm run dev`)의 주소다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
